{
  "manifest_version": 3,
  "name": "humanizer-ru: проверка текста на нейросеть",
  "short_name": "humanizer-ru",
  "version": "3.25.0",
  "description": "Балл чистоты 0-100 и подсветка AI-оборотов в русском тексте. Откалибровано на 55 тысячах текстов. Считает в браузере, без отправки.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "humanizer-ru: проверить текст",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "minimum_chrome_version": "116",
  "homepage_url": "https://humanizer-ru.aifrontier.tech/"
}
